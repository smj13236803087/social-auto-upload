<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  每天 10:00 和 22:00 自动同步 @bbqbro Shorts -> B站（每次 1 条，一天共 2 条）

  安装:
    cp scripts/com.sau.yt-shorts-daily.plist ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.sau.yt-shorts-daily.plist 2>/dev/null
    launchctl load ~/Library/LaunchAgents/com.sau.yt-shorts-daily.plist

  立刻试跑:
    launchctl start com.sau.yt-shorts-daily

  卸载:
    launchctl unload ~/Library/LaunchAgents/com.sau.yt-shorts-daily.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sau.yt-shorts-daily</string>

  <key>WorkingDirectory</key>
  <string>/Applications/social-auto-upload</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Applications/social-auto-upload/.venv/bin/python</string>
    <string>/Applications/social-auto-upload/scripts/sync_yt_shorts_to_ks_bili.py</string>
    <string>--channel</string>
    <string>https://www.youtube.com/@bbqbro/shorts</string>
    <string>--account</string>
    <string>boss rabbit</string>
    <string>--daily-limit</string>
    <string>1</string>
    <string>--cookies-from-browser</string>
    <string>edge</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>10</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>22</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Applications/social-auto-upload/logs/yt_shorts_daily.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Applications/social-auto-upload/logs/yt_shorts_daily.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Applications/social-auto-upload/.venv/bin:/Users/shaomaojia/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
