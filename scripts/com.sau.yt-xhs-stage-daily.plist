<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  北京时间每天 08:00 和 20:00：下载 Shorts 到 iCloud「sau-xhs-待发」供手机手动发小红书
  自 2026-08-14 起执行；之前触发会跳过。
  每次跑会删除云盘里昨天及更早的待发文件夹。

  安装:
    cp scripts/com.sau.yt-xhs-stage-daily.plist ~/Library/LaunchAgents/
    launchctl bootout gui/$(id -u)/com.sau.yt-xhs-stage-daily 2>/dev/null
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.sau.yt-xhs-stage-daily.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sau.yt-xhs-stage-daily</string>

  <key>WorkingDirectory</key>
  <string>/Applications/social-auto-upload</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Applications/social-auto-upload/.venv/bin/python</string>
    <string>/Applications/social-auto-upload/scripts/sync_yt_xhs_stage.py</string>
    <string>--channel</string>
    <string>https://www.youtube.com/@kochiasmr/shorts</string>
    <string>--daily-limit</string>
    <string>1</string>
    <string>--cookies-from-browser</string>
    <string>edge</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>8</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>20</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Applications/social-auto-upload/logs/yt_xhs_stage_daily.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Applications/social-auto-upload/logs/yt_xhs_stage_daily.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Applications/social-auto-upload/.venv/bin:/Users/shaomaojia/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>TZ</key>
    <string>Asia/Shanghai</string>
  </dict>
</dict>
</plist>
