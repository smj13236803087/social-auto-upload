<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  抖音定时已停用（2026-08-18）。不要再 bootstrap 这个 plist。
  如需恢复:
    cp scripts/com.sau.yt-douyin-daily.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.sau.yt-douyin-daily.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sau.yt-douyin-daily</string>

  <key>WorkingDirectory</key>
  <string>/Applications/social-auto-upload</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Applications/social-auto-upload/.venv/bin/python</string>
    <string>/Applications/social-auto-upload/scripts/sync_yt_douyin.py</string>
    <string>--channel</string>
    <string>https://www.youtube.com/@kochiasmr/shorts</string>
    <string>--account</string>
    <string>boss rabbit</string>
    <string>--daily-limit</string>
    <string>1</string>
    <string>--lookback</string>
    <string>150</string>
    <string>--cookies-from-browser</string>
    <string>edge</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>10</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>17</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key>
      <integer>22</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
  </array>

  <key>StandardOutPath</key>
  <string>/Applications/social-auto-upload/logs/yt_douyin_daily.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Applications/social-auto-upload/logs/yt_douyin_daily.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Applications/social-auto-upload/.venv/bin:/Users/shaomaojia/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>TZ</key>
    <string>Asia/Shanghai</string>
    <key>PLAYWRIGHT_BROWSERS_PATH</key>
    <string>/Users/shaomaojia/Library/Caches/ms-playwright</string>
  </dict>
</dict>
</plist>
