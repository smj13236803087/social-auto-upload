[Unit]
Description=AutoSelf web_mvp
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/autoself
EnvironmentFile=/home/ubuntu/autoself/.env
ExecStart=/home/ubuntu/apps/autoself/.venv/bin/python -m gunicorn -c web_mvp/gunicorn.conf.py web_mvp.app:app
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=35
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
